FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /workspace

COPY pom.xml ./
COPY app ./app
COPY tools ./tools
COPY resources ./resources

RUN mvn -q -pl tools/preprocessor -am clean package -DskipTests
RUN java -jar tools/preprocessor/target/preprocessor-0.1.0-SNAPSHOT-all.jar resources/references.json.gz app/src/main/resources/fraud-index.dat
RUN mvn -q -pl app -am package -DskipTests

FROM eclipse-temurin:21-jdk
WORKDIR /app

COPY --from=build /workspace/app/target/app-0.1.0-SNAPSHOT.jar /app/app.jar
COPY --from=build /workspace/app/src/main/resources/fraud-index.dat /app/resources/fraud-index.dat

ENV PORT=8080
ENV INDEX_BINARY_FILE=/app/resources/fraud-index.dat
ENV SERVER_THREADS=1

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
